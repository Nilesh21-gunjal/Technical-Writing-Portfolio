      "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/devices?page=1&per_page=20&status=active&site_code=SITE-001"},
      "response": [{"name": "Device page", "originalRequest": {"method": "GET", "url": "{{baseUrl}}/devices"}, "status": "OK", "code": 200, "_postman_previewlanguage": "json", "header": [], "cookie": [], "body": "{\n  \"data\": [{\"id\": \"DEV-2024-001842\", \"external_id\": \"LD-SENSOR-042\"}],\n  \"pagination\": {\"page\": 1, \"per_page\": 20, \"total_items\": 1, \"total_pages\": 1}\n}"}]
    },
    {
      "name": "Register device",
      "event": [{"listen": "test", "script": {"exec": [
