      "response": [{"name": "Device registered", "originalRequest": {"method": "POST", "url": "{{baseUrl}}/devices"}, "status": "Created", "code": 201, "_postman_previewlanguage": "json", "header": [], "cookie": [], "body": "{\n  \"id\": \"DEV-2024-001842\",\n  \"external_id\": \"LD-SENSOR-042\",\n  \"status\": \"inactive\"\n}"}]
